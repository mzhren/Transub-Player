<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TransubPlayer.Core — 跨平台服务层（macOS 移植 Phase 1）。

    策略：通过 Compile Include 链接 WPF 工程内的共享服务源文件（单一事实来源），
    Windows 构建路径完全不受影响；Windows 专属服务（托盘/文件关联/单实例/窗口chrome/
    MarkOfTheWeb/更新安装器等）不进入本工程。

    说明：链接文件在 Windows 机器上有完整构建验证，本工程只新增 mac 分支文件。
    任何对链接文件的修改必须在 Windows 上重新验证 WPF 构建。
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TransubPlayer</RootNamespace>
    <Version>1.6.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1-preview1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1-preview1" />
    <PackageReference Include="Whisper.net.Runtime.Metal" Version="1.9.1-preview1" />
  </ItemGroup>

  <!-- 本地化字符串 JSON（由 Strings.*.xaml 生成）。
       LogicalName 必须显式指定：strings.zh-Hans.json 这类 "名称.文化.扩展" 文件名会被
       MSBuild 误判为本地化资源而拆进卫星程序集，导致主程序集拿不到资源。 -->
  <ItemGroup>
    <EmbeddedResource Include="Localization/strings.zh-Hans.json" WithCulture="false" LogicalName="TransubPlayer.Localization.strings.zh-Hans.json" />
    <EmbeddedResource Include="Localization/strings.en.json" WithCulture="false" LogicalName="TransubPlayer.Localization.strings.en.json" />
    <EmbeddedResource Include="Localization/strings.ja.json" WithCulture="false" LogicalName="TransubPlayer.Localization.strings.ja.json" />
    <EmbeddedResource Include="Localization/strings.ko.json" WithCulture="false" LogicalName="TransubPlayer.Localization.strings.ko.json" />
  </ItemGroup>

  <!-- 共享服务（自 WPF 工程链接，保持单一事实来源） -->
